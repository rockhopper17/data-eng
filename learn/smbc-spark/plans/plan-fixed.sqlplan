<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4230.2"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT&#xa;        DATEFROMPARTS(YEAR(t.exit_time), MONTH(t.exit_time), 1)     AS trade_month,&#xa;        COUNT(*)                                                    AS trade_count,&#xa;        SUM(t.profit)                                                AS monthly_profit,&#xa;        AVG(CAST(t.is_win AS FLOAT))                                 AS win_rate,&#xa;        AVG(CASE WHEN t.profit &gt; 0 THEN t.profit END)                AS avg_win,&#xa;        AVG(CASE WHEN t.profit &lt; 0 THEN t.profit END)                AS avg_loss,&#xa;        MIN(t.drawdown)                                              AS worst_drawdown,&#xa;        SUM(SUM(t.profit)) OVER (&#xa;            ORDER BY DATEFROMPARTS(YEAR(t.exit_time), MONTH(t.exit_time), 1)&#xa;            ROWS UNBOUNDED PRECEDING)                                AS cumulative_profit,&#xa;        RANK() OVER (ORDER BY SUM(t.profit) ASC)                     AS worst_month_rank&#xa;    FROM dbo.trades_gold t&#xa;&#xa;-- leave this in to test perf tuning in the execution plan&#xa;-- WHERE YEAR(t.exit_time) = @Year&#xa;-- fixed predicate, sargable&#xa;WHERE t.exit_time &gt;= DATEFROMPARTS(@Year, 1, 1)&#xa;  AND t.exit_time &lt;  DATEFROMPARTS(@Year + 1, 1, 1)&#xa;&#xa;    GROUP BY DATEFROMPARTS(YEAR(t.exit_time), MONTH(t.exit_time), 1)&#xa;    ORDER BY trade_month" StatementId="1" StatementCompId="4" StatementType="SELECT" StatementSqlHandle="0x0900F7D5AA4B22667927FA6B2F837539827B0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="3" ParentObjectId="1877581727" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="12.1349" StatementEstRows="105154" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x473A950F9325FE57" QueryPlanHash="0xD1E136CA9999F772" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="true" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="8" MemoryGrant="39808" CachedPlanSize="152" CompileTime="32" CompileCPU="32" CompileMemory="880"><ThreadStat Branches="3" UsedThreads="17"><ThreadReservation NodeId="0" ReservedThreads="24"></ThreadReservation></ThreadStat><MemoryGrantInfo SerialRequiredMemory="640" SerialDesiredMemory="31320" RequiredMemory="9088" DesiredMemory="39808" RequestedMemory="39808" GrantWaitTime="0" MaxQueryMemory="971104" GrantedMemory="39808" MaxUsedMemory="10472" LastRequestedMemory="0" IsMemoryGrantFeedbackAdjusted="No: First Execution"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="81971" EstimatedPagesCached="40985" EstimatedAvailableDegreeOfParallelism="4" MaxCompileMemory="3644480"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-08-26T21:08:17.37" ModificationCount="0" SamplingPercent="100" Statistics="[ix_trades_gold_exit_time]" Table="[trades_gold]" Schema="[dbo]" Database="[Kalmia]"></StatisticsInfo></OptimizerStatsUsage><WaitStats><Wait WaitType="CXSYNC_PORT" WaitTimeMs="297" WaitCount="70"></Wait><Wait WaitType="CXPACKET" WaitTimeMs="121" WaitCount="385"></Wait><Wait WaitType="CXSYNC_CONSUMER" WaitTimeMs="13" WaitCount="28"></Wait><Wait WaitType="RESERVED_MEMORY_ALLOCATION_EXT" WaitTimeMs="1" WaitCount="1783"></Wait><Wait WaitType="SOS_SCHEDULER_YIELD" WaitTimeMs="1" WaitCount="11"></Wait></WaitStats><QueryTimeStats ElapsedTime="106" CpuTime="263"></QueryTimeStats><RelOp NodeId="0" PhysicalOp="Parallelism" LogicalOp="Gather Streams" EstimateRows="105154" EstimateIO="0" EstimateCPU="0.813932" AvgRowSize="71" EstimatedTotalSubtreeCost="12.1349" Parallel="1" EstimateRebinds="0" EstimateRewinds="0" EstimatedExecutionMode="Row"><OutputList><ColumnReferen