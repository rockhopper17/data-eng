<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4230.2"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT&#xd;&#xa;        DATEFROMPARTS(YEAR(t.exit_time), MONTH(t.exit_time), 1)     AS trade_month,&#xd;&#xa;        COUNT(*)                                                    AS trade_count,&#xd;&#xa;        SUM(t.profit)                                                AS monthly_profit,&#xd;&#xa;        AVG(CAST(t.is_win AS FLOAT))                                 AS win_rate,&#xd;&#xa;        AVG(CASE WHEN t.profit &gt; 0 THEN t.profit END)                AS avg_win,&#xd;&#xa;        AVG(CASE WHEN t.profit &lt; 0 THEN t.profit END)                AS avg_loss,&#xd;&#xa;        MIN(t.drawdown)                                              AS worst_drawdown,&#xd;&#xa;        SUM(SUM(t.profit)) OVER (&#xd;&#xa;            ORDER BY DATEFROMPARTS(YEAR(t.exit_time), MONTH(t.exit_time), 1)&#xd;&#xa;            ROWS UNBOUNDED PRECEDING)                                AS cumulative_profit,&#xd;&#xa;        RANK() OVER (ORDER BY SUM(t.profit) ASC)                     AS worst_month_rank&#xd;&#xa;    FROM dbo.trades_gold t&#xd;&#xa;    WHERE YEAR(t.exit_time) = @Year&#xd;&#xa;    GROUP BY DATEFROMPARTS(YEAR(t.exit_time), MONTH(t.exit_time), 1)&#xd;&#xa;    ORDER BY trade_month" StatementId="1" StatementCompId="6" StatementType="SELECT" StatementSqlHandle="0x0900F5A8595559EA4BD0B9E1E059C5F5836F0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="3" ParentObjectId="1877581727" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="17.9398" StatementEstRows="98895.1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xAE97DE213B957D47" QueryPlanHash="0xE6C1E5630C7B04D5" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="true" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="8" MemoryGrant="54016" CachedPlanSize="136" CompileTime="82" CompileCPU="39" CompileMemory="880"><ThreadStat Branches="3" UsedThreads="17"><ThreadReservation NodeId="0" ReservedThreads="24"></ThreadReservation></ThreadStat><MemoryGrantInfo SerialRequiredMemory="640" SerialDesiredMemory="45728" RequiredMemory="8896" DesiredMemory="54016" RequestedMemory="54016" GrantWaitTime="7" MaxQueryMemory="971104" GrantedMemory="54016" MaxUsedMemory="10360" LastRequestedMemory="37760" IsMemoryGrantFeedbackAdjusted="Yes: Adjusting"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="81971" EstimatedPagesCached="40985" EstimatedAvailableDegreeOfParallelism="4" MaxCompileMemory="3657152"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-08-26T18:53:22.52" ModificationCount="0" SamplingPercent="14.5002" Statistics="[_WA_Sys_00000007_70DDC3D8]" Table="[trades_gold]" Schema="[dbo]" Database="[Kalmia]"></StatisticsInfo></OptimizerStatsUsage><WaitStats><Wait WaitType="CXSYNC_PORT" WaitTimeMs="216" WaitCount="61"></Wait><Wait WaitType="CXPACKET" WaitTimeMs="202" WaitCount="162"></Wait><Wait WaitType="LATCH_EX" WaitTimeMs="45" WaitCount="35"></Wait><Wait WaitType="SOS_SCHEDULER_YIELD" WaitTimeMs="36" WaitCount="93"></Wait><Wait WaitType="RESERVED_MEMORY_ALLOCATION_EXT" WaitTimeMs="12" WaitCount="1647"></Wait><Wait WaitType="CXSYNC_CONSUMER" WaitTimeMs="8" WaitCount="21"></Wait><Wait WaitType="SESSION_WAIT_STATS_CHILDREN" WaitTimeMs="2" WaitCount="15"></Wait><Wait WaitType="MEMORY_ALLOCATION_EXT" WaitTimeMs="1" WaitCount="249"></Wait></WaitStats><QueryTimeStats ElapsedTime="131" CpuTime="750"></QueryTimeStats><RelOp NodeId="0" PhysicalOp="Parallelism" LogicalOp="Gather Streams" EstimateRows="98895.1" EstimateIO="0" EstimateCPU="0.767185" AvgRowSize="71" EstimatedTotalSubtreeCost="17.9398" Parallel="1" EstimateR